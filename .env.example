# Copy this file to .env and fill in every empty value. Never commit .env.
# docker compose reads .env automatically and refuses to start while a
# required value is missing.

# MySQL account the app uses (created on the first start).
DB_USERNAME=employee_app
DB_PASSWORD=

# MySQL root password (only MySQL itself uses it).
MYSQL_ROOT_PASSWORD=

# First admin account for the web app. Password: at least 12 characters.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Optional read-only account.
APP_VIEWER_USERNAME=
APP_VIEWER_PASSWORD=

# Port on this computer that serves the app.
APP_PORT=8080
